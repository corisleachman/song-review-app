import Stripe from 'stripe';

Deno.serve(async (request) => {
  if (request.method !== 'POST') {
    return new Response(null, { status: 405, headers: { Allow: 'POST' } });
  }

  const signature = request.headers.get('stripe-signature');
  if (!signature) return Response.json({ error: 'Missing Stripe signature.' }, { status: 400 });

  const ref = Deno.env.get('STAGING_SUPABASE_PROJECT_REF');
  const url = Deno.env.get('SUPABASE_URL');
  const signingSecret = Deno.env.get('STRIPE_WEBHOOK_SECRET');
  if (
    !ref || !/^[a-z0-9]{20}$/.test(ref) || ref === 'hxtsuhmqrufcdplidtov'
    || url !== `https://${ref}.supabase.co`
    || !Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')
    || !/^(sk|rk)_test_/.test(Deno.env.get('STRIPE_SECRET_KEY') ?? '')
    || !signingSecret?.startsWith('whsec_')
  ) {
    return Response.json({ error: 'Staging webhook configuration is invalid.' }, { status: 503 });
  }

  const body = await request.text();
  let event: Stripe.Event;
  try {
    event = await Stripe.webhooks.constructEventAsync(body, signature, signingSecret);
  } catch {
    return Response.json({ error: 'Invalid Stripe signature.' }, { status: 400 });
  }

  if (event.livemode !== false || (
    event.type !== 'customer.subscription.updated' && event.type !== 'customer.subscription.deleted'
  )) {
    return Response.json({ error: 'Event is outside the staging webhook scope.' }, { status: 400 });
  }

  const { POST } = await import('./source/app/api/stripe/webhook/route.ts');
  return POST(new Request(request.url, {
    method: 'POST',
    headers: { 'stripe-signature': signature },
    body,
  }));
});
